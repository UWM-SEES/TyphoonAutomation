            mask {
                icon = "image(\'converter_cabinet.svg\')"
                description = "<html><head><meta name=\"qrichtext\" content=\"1\"></meta><style type=\"text/css\">p, li { white-space: pre-wrap; }</style></head><body style=\"\"><p style=\"margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Battery inverter (Switching)  model.</p><p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br></br></p><p style=\"margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The input \"mode\" define if the battery inverter is in grid forming or voltage mode (0) or in grid following  or current mode (1). When in voltage mode, the inverter will follow the references of voltage and frequency. When in current mode, the inverter will follow references for active and reactive power.</p><p style=\"margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The number of regular inputs is 5 and of outputs is 14. They are organized as an array in the following order:</p><p style=\"margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Inputs: 0 - On; 1 - mode; 2 - f_ref; 3 - Vref; 4 - Pref; 5 - Qref;</p><p style=\"margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Outputs: 0 - Connected; 1 - Inv_On; 2 - Va; 3 - Vb; 4 - Vc; 5 - Vt; 6 - Ia; 7 - Ib; 8 - Ic; 9 - f; 10 - P; 11 - Q; 12 - S; 13 - pf;</p><p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><br></br></p></body></html>"

                Sn {
                    label = "Nominal power"
                    widget = edit
                    type = generic
                    default_value = "2.2222e+05"
                    unit = "VA"
                    group = "1 - General"
                }

                Vn {
                    label = "Nominal voltage"
                    widget = edit
                    type = generic
                    default_value = "480.0"
                    unit = "V (line to line)"
                    group = "1 - General"
                }

                Vn_dc {
                    label = "Nominal DC link voltage"
                    widget = edit
                    type = generic
                    default_value = "800"
                    unit = "V"
                    group = "1 - General"
                }

                fn {
                    label = "Nominal frequency"
                    widget = edit
                    type = generic
                    default_value = "60.0"
                    unit = "Hz"
                    group = "1 - General"
                }

                fsw {
                    label = "Switching frequency"
                    widget = edit
                    type = generic
                    default_value = "10000"
                    unit = "Hz"
                    group = "1 - General"
                }

                Ts {
                    label = "Execution rate"
                    widget = edit
                    type = generic
                    default_value = "Ts"
                    unit = "s"
                    group = "1 - General"
                }

                L {
                    label = "LC filter inductance"
                    widget = edit
                    type = generic
                    default_value = "3.3002e-04"
                    unit = "H"
                    group = "2 - Filter"
                }

                R {
                    label = "LC filter inductor ESR"
                    widget = edit
                    type = generic
                    default_value = "0.1"
                    unit = "Ohms"
                    group = "2 - Filter"
                }

                OutputFilterFc {
                    label = "LC filter cut-off frequency"
                    widget = edit
                    type = generic
