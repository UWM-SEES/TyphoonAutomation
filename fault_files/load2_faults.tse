            component "core/C function" Ride_Through_State_Machine {
                arb_defs = "/*Begin code section*/

/*End code section*/"
                execution_rate = "Ts"
                global_variables = "real Pre_Count_Ride_Through;real Pre_Count_Between_Disturbance;real Pre_Count_Between_Disturbance_Sets;real Ride_through_reconnect;real Next_state;real counter_limit_VRT_7_88;real counter_limit_VRT_5_7;real counter_limit_VRT_11_12;real counter_limit_wait;real counter_wait_distrubance;real counter_limit_MC;real counter_MC;real counter;"
                init_fnc = "/*Begin code section*/
/*Fault=0;
Enable=0;*/
/*Counter_Between_Distrbances=0;
Counter_Between_Distrbances_sets=0;
Counter_Ride_through=0;*/

counter_limit_VRT_5_7=10/execution_rate;
counter_limit_VRT_7_88=20/execution_rate;
counter_limit_VRT_11_12=12/execution_rate;
counter_limit_wait=5/execution_rate;
counter_wait_distrubance=0;
counter_limit_MC=1/execution_rate;
counter_MC=0;
counter=0;
Pre_Count_Between_Disturbance=0;
Pre_Count_Between_Disturbance_Sets=0;
/*End code section*/"
                input_terminals = "inherit Enable;inherit FaultReset;inherit Fault_From_Fault_Manager;real Input_Voltage;"
                input_terminals_dimensions = "inherit;inherit;inherit;inherit"
                input_terminals_feedthrough = "True;True;True;True"
                input_terminals_show_labels = "True;True;True;True"
                output_fnc = "/*Begin code section*/
//Selects the next state given the current state and inputs into the state machine

//OFFLINE STATE
if(Ride_Through_State == 0){
    if(Enable ==1 && Fault_From_Fault_Manager == 0){
        Next_state = 2;   //online 
    }
    else{
    Next_state = 0; //offline
    }
    Fault=0;
    Ride_Through=0;
  
}
//FAULT STATE
else if(Ride_Through_State == 1){
        if(FaultReset ==1 && Fault_From_Fault_Manager == 0){
        Next_state = 0;   //offline
    }
    else{
    Next_state = 1;    //fault
        }
        Fault=1;
        Ride_Through=0;
}
        
//ONLINE STATE
else if (Ride_Through_State == 2) {
  if (Fault_From_Fault_Manager == 1) {   
    Next_state = 1;   //fault
                         } 
         else if (Enable == 1) {
                  if (Input_Voltage > 1.1 || Input_Voltage < 0.88) {
                            Next_state = 3;   //voltage ride through
                                                  } 
                             else {
                                 Next_state = 2;  //online
                                   }
                                }
            else {
                    Next_state = 0;    //offline
                    }
                Fault=0;
        Ride_Through=0;
}
// voltage ride through 
else if(Ride_Through_State == 3){
    if(Fault_From_Fault_Manager == 1){
        Next_state = 1;    //fault
        }
    else {
            if(Enable == 1){
                if(Input_Voltage >= 1.2 || Input_Voltage <= 0.5){
                    Next_state =5;   // fault...momentery cessation
                    }
                else if(Input_Voltage >= 0.88 && Input_Voltage <= 1.1){
                    Next_state = 4;    //wait for disturbance
                    }
                    //Checks ride-through time has reached limit
                else if(Input_Voltage >= 0.70 && Input_Voltage < 0.88){
                     if(counter >= counter_limit_VRT_7_88){
                       Next_state =1;  //Fault
                       counter = 0;
                    }
                    else{
                    counter = counter + 1;
                        Next_state = 3;
                        }}
                else if(Input_Voltage >= 0.50 && Input_Voltage < 0.7){
                   if(counter >= counter_limit_VRT_5_7){
                       Next_state =1;  //Fault
                       counter = 0;
                    }
                    else{
                    counter = counter + 1;
                        }
                    }
               else if(Input_Voltage > 1.1 && Input_Voltage <=1.2){
                   if(counter >= counter_limit_VRT_11_12){
                       Next_state =1;  //Fault
                       counter = 0;
                    }
                    else{
                    counter = counter + 1;
                        }
                    }
                }
            else{
                Next_state = 0;  //offline
                }
        }
Fault=0;
Ride_Through=0;
}

//wait for disturbance to finished
else if(Ride_Through_State == 4){
     if(Fault_From_Fault_Manager == 1){
        Next_state = 1;  //fault
        } 
    else{
            if(Enable == 1){
                if(Input_Voltage < 1.1 && Input_Voltage > 0.88){
                    if(counter_wait_distrubance >=counter_limit_wait){
                       Next_state =2;   //online
                       counter_wait_distrubance = 0;
                    }
                    else {
                        counter_wait_distrubance=counter_wait_distrubance+1;
                        Next_state =4;   //wait for distrubance
                        }
                    }
                else{
                Next_state =4;   //wait for distrubance
                }
            }
            else{
            Next_state = 0; //offline
                }
    }
Fault=0;
Ride_Through=0;
}   
//Momentery Cessation
else if(Ride_Through_State == 5){
        if(Fault_From_Fault_Manager == 1){
            Next_state = 1; //fault
            }
    else{
            if(Enable == 1){
                if(Input_Voltage < 0.55  || Input_Voltage > 1.18){
                     if(counter_MC >=counter_limit_MC){
                       Next_state =1;  //fault
                       counter_MC = 0;
                    }
                     else{
                    Next_state =5;
                    counter_MC= counter_MC+1;//Momentery Cessation
                    }
                }
                else{
                Next_state = 3;  //voltage ride through
                    }
                }
           else{
               Next_state = 0;  //Offline
               } 
           }
Fault=0;
Ride_Through=1;
}
 



// This updates the selection of the next state to the present state for the next timestep.
Ride_Through_State = Next_state;
/*End code section*/"
                output_terminals = "inherit Fault;inherit Ride_Through;inherit Ride_Through_State;"
                output_terminals_dimensions = "inherit;inherit;inherit"
                output_terminals_feedthrough = "True;True;True"
                output_terminals_show_labels = "True;True;True"
                update_fnc = "/*Begin code section*/
//the real output function
/*Offline MODE*/
/*if(Ride_Through_State==0){
           
            Fault=0;
        Ride_Through=0;
  
}

else if( Ride_Through_State==1){  
                     Fault=1;
        Ride_Through=0;
 
          }

else if(Ride_Through_State==2){
     
             Fault=0;
        Ride_Through=0;
        
         }

else if(Ride_Through_State==3){
                                                                
            Fault=0;
        Ride_Through=0;
     
               }

else if(Ride_Through_State==4){
                   
         Fault=0;
        Ride_Through=0;
                   }


  else if(Ride_Through_State==5){
                Fault=0;
        Ride_Through=1;
                }*/
/*End code section*/"
            }
