    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        # The Schematic API is imported as 'mdl'
        # To get the model file path, use 'mdl.get_model_file_path()'
        # To print information to the console, use info()
        
        Ts = 200e-6
        
        sqrt_2 = 2**(0.5)
        sqrt_3 = 3**(0.5)
        sqrt_2_over_3 = (2/3)**(0.5)
        fe_rated = 60
        
        #Time to close Circuit Breaker
        CB_ON_DELAY = 1/60;
        
        #Time to open Circuit Breaker
        CB_OFF_DELAY = 3/60;
        
        
        #Genset parameters calculation
        class Genset:
        
            #instance attribute
            def __init__(self, P_rated, Vac_rated, PF, fe_rated, pole_pairs):
                self.P_rated = P_rated
                self.S_rated = P_rated/PF
                self.Q_rated = (self.S_rated**2 - self.P_rated**2)**0.5
        
                self.Vac_rated = Vac_rated
                self.Iac_rated = self.S_rated/self.Vac_rated/sqrt_3
                self.PF = PF
                self.fe_rated = fe_rated
                self.pole_pairs = pole_pairs
                self.Vb= self.Vac_rated*sqrt_2_over_3  # Nominal/base voltage of machine terminal in V (Peak line to neutral voltage)
                self.Ib = self.Iac_rated*sqrt_2
                self.we_rated = 2.0*np.pi*self.fe_rated  # Electrical angular speed base
                self.wm_rated =self.we_rated/self.pole_pairs  # Mechanical angular speed base
                self.Zb = (self.Vac_rated*self.Vac_rated)/self.S_rated  # Impedance base
                self.Torque_b = self.S_rated/self.wm_rated  # Torque base
                self.Fb = self.Torque_b/self.wm_rated   # Friction Factor base
                self.Lb = self.Zb/self.we_rated  # Inductance base
        
                #Synchronous Machine Mechanical Parameters
                self.hp = self.P_rated/746.0 #Machine hp rated
                self.J = (self.hp/250.0)*(self.hp/500.0+1.0)*4.0*3 #rule of thumb of converting hp to inertia. 4x to include inertia of engine in diesel Genset
                self.H = self.J*self.wm_rated**2/(2*self.S_rated) #inertia in seconds
                self.F = 0.01*self.Fb # Friction in si units
        
                #Synchronous Machine Transient & Subtransient parameters [pu]
                self.Xd_Synchronous = 1.656 #1.81
                self.Xq_Synchronous = 1.328 #1.76
                self.Xd_Transient = 0.18 #0.3
                self.Xd_Subtransient = 0.072 #0.23
                self.Xq_Subtransient = 0.072 #0.25
                self.Td_Transient = 0.088
                self.Td_Subtransient = 0.016
                self.Tq_Subtransient = 0.0002
                self.Td0_Transient = 1.0
                self.Td0_Subtransient = 0.07
                self.Tq0_Subtransient = 0.03
        
                #Synchronous Machine Stator parameters [pu]
                self.Xls = 0.03*self.Xd_Synchronous # State leakage impedance [pu]. Complete Guess. Was 0.1.
                self.Rs_pu = 0.02 #State resistance [pu]. Also Complete Guess
        
                #Calculation of rotor parameters refered to stator side.
                #equations are from Ong Section 7.7 "Calculating Machine parameters"
                #Values are in pu
                #d = direct axis
                #q = quadrature axis
                #l = leakage
                #k = damper windings
                #prime = rotor values refered to stator
        
                #Direct magnetizing reactance. (7.128)
                self.Xmd = self.Xd_Synchronous - self.Xls
                #Quadrature magnetizing reactance. (7.127)
                self.Xmq = self.Xq_Synchronous - self.Xls
        
                #Field leakage reactance. (7.129)
                self.Xlfd_prime = (self.Xmd*(self.Xd_Transient-self.Xls))/(self.Xmd-(self.Xd_Transient - self.Xls))
        
                #Leakage reactance of d-axis damper winding. (7.132)
                self.Xlkd_prime = ((self.Xd_Subtransient-self.Xls)*self.Xmd*self.Xlfd_prime)/(self.Xlfd_prime*self.Xmd-(self.Xd_Subtransient-self.Xls)*(self.Xmd+self.Xlfd_prime))
        
                #Leakage reactance of q-axis damper winding. (7.135)
                self.Xlkq_prime = (self.Xmq*(self.Xq_Subtransient - self.Xls))/(self.Xmq-(self.Xq_Subtransient - self.Xls))
        
                #Field resistance. (7.138)
                self.Rf_prime_pu = 1.0/(self.we_rated*self.Td0_Transient)*(self.Xlfd_prime + self.Xmd)
        
                #D-axis damper resistance. (7.141)
                self.Rkd_prime_pu = 1.0/(self.we_rated*self.Td0_Subtransient)*(self.Xlkd_prime + self.Xd_Transient+self.Xls)
        
                #Q-axis damper resistance. (7.143)
                self.Rkq_prime_pu = 1.0/(self.we_rated*self.Tq0_Subtransient)*(self.Xlkq_prime + self.Xmq)
        
                #Convert Parameters from pu to SI
                self.Rs = self.Rs_pu*self.Zb
                self.Lls = self.Xls*self.Lb
                self.Lmd = self.Xmd*self.Lb
                self.Lmq = self.Xmq*self.Lb
                self.Rf_prime = self.Rf_prime_pu*self.Zb
                self.Llfd_prime = self.Xlfd_prime*self.Lb
                self.Rkd_prime = self.Rkd_prime_pu*self.Zb
                self.Llkd_prime = self.Xlkd_prime*self.Lb
                self.Rkq_prime = self.Rkq_prime_pu*self.Zb
                self.Llkq_prime = self.Xlkq_prime*self.Lb
        
                #Equations from Matlab help on Synchronous Machine
                #Field voltage to produce 1pu stator voltage
                self.Vfdn_prime = self.Rf_prime_pu*self.Vb/self.Xmd
        
                #Based field current
                self.Ifn_prime = self.Ib/self.Xmd
        
        
        
        #Load parameters calculation
        class calc_load_params:
        
            #instance attribute
            def __init__(self, P_rated, PF, Vac_rated):
                self.P_rated = P_rated
                self.PF = PF
                self.Vac_rated = Vac_rated
        
                self.S_rated = self.P_rated/self.PF
                self.Iac_rated = self.S_rated/self.Vac_rated/sqrt_3
                
        #InductionMachine parameters calculation
        class calc_InductionMachine_parameters:
        
            def __init__(self, S_rated,VLL_rated, PF, fe, poles):
                self.S_rated = S_rated
                self.PF_rated = PF
                self.P_rated = S_rated*self.PF_rated
                self.VLL_rated = VLL_rated
                self.fe_Rated= fe
                self.I_rated = self.S_rated/sqrt_3/self.VLL_rated
                self.Z_base = self.VLL_rated/sqrt_3/self.I_rated
        
                self.we =  self.fe_Rated*2*np.pi
                self.poles = poles
                self.pole_pairs = self.poles/2
                self.ws = 2/self.poles*self.we
        
                self.s_rated = 0.02
                self.ns = 120*self.fe_Rated/self.poles
                self.wm_rated = (1-self.s_rated)*self.ws
                self.Tm_rated = self.P_rated/self.wm_rated
                self.F =0 
                self.hp = self.P_rated/746
                self.J = (self.hp/250)*((self.hp/500)+1)
        
                self.I_start = 3.75*self.I_rated
                #then the impedance at start up is
                self.Z_start = (self.VLL_rated/sqrt_3/self.I_start)
        
                #Assume that Z start~j(x1+x2) = j(2*x1) and x1=x2
                self.X1 = self.Z_start/2
                self.X2 = self.X1
        
                #Assume that the no load corrent is 0.1 times rated current
                self.I_NL = 0.1 *self.I_rated
        
                #then the impedance at no load is
                self.Z_NL = (self.VLL_rated/sqrt_3/self.I_NL)
        
                #assume that Z_NL~j(x1+xm)
                self.Xm = self.Z_NL-self.X1
        
                #assume that Z_rated = Z_bas*PF+j(Z_base*sin(acos(PF))
                #and that Z_base*PF_rated~0.95*r2/s_rated
                #if it is a high power factor motor (0.9 PF sp yes) s_rated is smaller
        
                self.R2 = self.Z_base*self.PF_rated*self.s_rated
                
        
                #assume r1=0.5*r2
                self.R1 = 0.5*self.R2
        
                self.Lm = self.Xm/self.we
                self.L1 = self.X1/self.we
                self.L2 = self.X2/self.we
        
                #need a load for the motor simple fan load here.
                self.TmPerOmegaSquared = (self.Tm_rated/(self.wm_rated**2))
        
        #PV farm parameters calculation
        
        class PVFarm_Param_calc:
        
            def __init__(self,VA_rated, PF_rated, Vdc_rated,Vac_rated, fe_rated):
                self.VA_rated = VA_rated
                self.PF_rated = PF_rated
                self.Vdc_rated = Vdc_rated
                self.Vac_rated = Vac_rated
        
                self.Pac_Rated = self.PF_rated*self.VA_rated
                self.Q_Rated = ((self.VA_rated)**2-(self.Pac_Rated)**2)**0.5
                self.Iac_Rated = self.VA_rated/(sqrt_3*self.Vac_rated)
                self.fe_rated = fe_rated
        
        
                #Base values
                self.Pbin = self.Pac_Rated
                self.Vbin = sqrt_2_over_3*self.Vac_rated
                self.Ibin = sqrt_2*self.Iac_Rated
                self.Zbin = self.Vbin/self.Ibin
                self.Lbin = self.Zbin/(2*np.pi*self.fe_rated)    ###Change the math to np for typhoon math library.
                self.Cbin = 1/(2*np.pi*self.fe_rated*self.Zbin)
                self.Vb = self.Vdc_rated
        
                #DC to AC converter
                self.fsw = 2.5e3
                self.Cdc = 10e-3*4
                self.CdcESR = 0.001
        
                #AC filter
                self.delta_iL_pu = 0.1
                self.delta_iL = self.delta_iL_pu*self.Ibin
        
                self.Ldm1 = self.Vdc_rated/(8*self.delta_iL*self.fsw)
                self.Ldm2 = self.Ldm1/3
        
                self.delta_vac_pu = 0.05
                self.duty_cycle = 0.5
                self.Cdm = (1-self.duty_cycle)/(8*self.Ldm1*(self.fsw)**2*self.delta_vac_pu)
        
                self.Rd = (self.Ldm1/self.Cdm)**0.5
        
                self.Ldm_Total = self.Ldm1+self.Ldm2
                self.X1 = 1*2*np.pi*self.fe_rated*self.Ldm1                                   #change math to np
        
                self.XL_decouple_term = 2*self.X1*self.Ibin/self.Vb
                self.vdq_scaling = self.Vbin*2/self.Vb
        
                self.Idq_Regulator_Kp = 0.95
                self.Idq_Regulator_Ki = 10
        
                self.adc_scaling_current = self.Ibin/5
                self.adc_scaling_voltage = self.Vbin/5
        
        #Transformer parameters calculation
        
        class calc_Xfmr_parameters():
        
            def __init__(self, Power, fe_rated, Primary_Voltage, Secondary_Voltage):
                self.VA_rated = Power
                self.fe_rated = fe_rated
                self.Vb_Pri = Primary_Voltage
                self.Vb_Sec = Secondary_Voltage
        
                self.R1_pu = 0.01
                self.R2_pu = 0.01
                self.L1_pu = 0.02
                self.L2_pu = 0.02
                self.Rm_pu = 500
                self.Lm_pu = 500
                
                
        #Genset value declaration
        Genset_1 = Genset(400e3, 480, 0.8, fe_rated , 4.0)
        
        #Load value declaration
        Load3 = calc_load_params(25e3, 0.90,480)
        Load1 = calc_load_params(25e3, 0.95,480)
        
        #Induction machine value declaration
        IM = calc_InductionMachine_parameters(100e3,480, 0.8, 60,2)
        
        #PV farm value declaration
        PVF = PVFarm_Param_calc(45e3,0.9,800,480,60)
        
        #Transformer value declaration
        Xfmr1 = calc_Xfmr_parameters(45e3,60,480,480)
        Xfmr2 = calc_Xfmr_parameters( 2.2222e+05, 60,480,480)
    ENDCODE
}
