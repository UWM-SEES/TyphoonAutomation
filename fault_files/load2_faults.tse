                        component "core/C function" dq_vector_limiter {
                            arb_defs = "/*Begin code section*/

/*End code section*/"
                            execution_rate = "Ts"
                            input_terminals = "real dq_magnitude_limit;inherit mode;inherit d;inherit q;"
                            input_terminals_dimensions = "inherit;inherit;inherit;inherit"
                            input_terminals_feedthrough = "True;True;True;True"
                            input_terminals_show_labels = "True;True;True;True"
                            output_fnc = "/*Begin code section*/
dq_magnitude = sqrt((d*d)+q*q);

    if (mode == 0){
        if(dq_magnitude > dq_magnitude_limit)
        {
            d_sat = (d/dq_magnitude)*dq_magnitude_limit;
            q_sat = (q/dq_magnitude)*dq_magnitude_limit;
            }
        else{
            d_sat =d;
            q_sat =q;
            }
        }
    else if(mode==1){
        if (d> dq_magnitude_limit)
        {
            d_sat = dq_magnitude_limit;
            q_sat = 0;
            }
        else if(d<-dq_magnitude_limit){
            d_sat = -dq_magnitude_limit;
            q_sat = 0;
            }
        else if(dq_magnitude>dq_magnitude_limit){
            d_sat = d;
            if (q<0){
                q_sat = -1*sqrt((dq_magnitude_limit*dq_magnitude_limit)-(d*d));
                }
            else{
                q_sat = sqrt((dq_magnitude_limit*dq_magnitude_limit)-(d*d));
                }
            }
        else{
            d_sat =d;
            q_sat =q;
            }
        }
/*End code section*/"
                            output_terminals = "inherit d_sat;inherit q_sat;inherit dq_magnitude;"
                            output_terminals_dimensions = "inherit;inherit;inherit"
                            output_terminals_feedthrough = "True;True;True"
                            output_terminals_show_labels = "True;True;True"
                        }
