                        component "core/Discrete Transfer Function" LPF_q1 {
                            a_coeff = "[1,2*zeta*(2*np.pi*fc_w),(2*np.pi*fc_w)**2.0]"
                            b_coeff = "(2*np.pi*fc_w)**2.0"
                            domain = "S-domain"
                            method = "Bilinear"
                        }
                        [
