                max = "2"
                min = "0"
                unit = ""
            }
            [
                position = 8160, 8144
            ]

            component "core/SCADA Input" Gen_On {
                addr = "1427111952"
                execution_rate = "Ts"
                max = "1"
                min = "0"
                unit = ""
            }
            [
                position = 8120, 7992
            ]

            component "core/SCADA Input" Load_share {
                execution_rate = "Ts"
