                        component "core/C function" wait_to_change {
                            global_variables = "real wait_time;real counter;"
                            init_fnc = "/*Begin code section*/
counter = 0;
wait_time = 0.01;
/*End code section*/"
                            input_terminals = "inherit in;inherit reset;"
                            input_terminals_dimensions = "inherit;inherit"
                            input_terminals_feedthrough = "[u\'\']"
                            input_terminals_show_labels = "False;False;"
                            output_fnc = "/*Begin code section*/
if(in <= 0){
    counter = 0;
    out = 0;
}
else{
    if(counter >= wait_time){
        out = 1;
    }
    else{
        out = 0;
        counter += execution_rate*in;
    }
}

if(reset == 1){
    counter = 0;
    out = 0;
}
/*End code section*/"
                            output_terminals_dimensions = "inherit"
                            output_terminals_feedthrough = "[u\'\']"
                        }
