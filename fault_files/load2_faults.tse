                            output_fnc = "/*Begin code section*/
if(control_mode == 0){
    stand_by = 1;
    grid_forming = 0;
    grid_following = 0;
}
else{
    if(control_mode == 1){
        stand_by = 0;
        grid_forming = 1;
        grid_following = 0;
    }
    else{
        stand_by = 0;
        grid_forming = 0;
        grid_following = 1;
    }
}
/*End code section*/"
                            output_terminals = "real stand_by;inherit grid_forming;inherit grid_following;"
                            output_terminals_dimensions = "inherit;inherit;inherit"
                            output_terminals_feedthrough = "[\'\']"
