                            output_fnc = "/*Begin code section*/
if(LimitChange == 0.0){
    LimitChange_var = 0.01;
}
else{
    LimitChange_var = LimitChange;
}

if(in>=Vrmax*LimitChange_var){
    out = Vrmax*LimitChange_var;
}
else{
    if(in<=Vrmin*LimitChange_var){
        out = Vrmin*LimitChange_var;
    }
    else{
        out = in;
    }
}
/*End code section*/"
