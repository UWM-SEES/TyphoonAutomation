        component Subsystem DG_out1 {
            layout = dynamic
            component "core/Probe" Out {
                execution_rate = "Ts"
                signal_access = "Inherit"
            }
            [
                position = 8192, 8192
                rotation = left
                scale = -1, 1
            ]

            port outputs {
                position = right:1
                kind = sp
                direction =  out
                sp_type {
                    default = auto
                    readonly = True
                }
            }
            [
                position = 8192, 8256
                rotation = left
                hide_name = True
            ]

            connect Out.in outputs as Connection1
        }
        [
            position = 7256, 8024
            rotation = right
            size = 48, 48
        ]

        component Subsystem DG_in1 {
            layout = dynamic
            component "core/SCADA Input" pf_ref {
                execution_rate = "Ts"
                unit = ""
            }
            [
                position = 8120, 8112
            ]

            component "core/SCADA Input" Gen_OP_mode {
                def_value = "1"
